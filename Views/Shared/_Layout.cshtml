<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BookingSystem</title>
    <link href="~/lib/tailwind.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)

</head>
<body class="bg-gradient-to-b from-white to-slate-50
">
    <header class="bg-gradient-to-r from-teal-700 to-emerald-500 rounded-b-[75px] max-h-[250px] min-h-[150px] px-4 py-2 flex items-center justify-between">
        <a asp-controller="Home" asp-action="index">
            <div class="ml-4 sm:ml-[50px] transition duration-200 hover:scale-110">
                <img src="~/css/assets/patou_name_logo.png" alt="logo" class="h-[80px] sm:h-[120px] object-contain" />
            </div>
        </a>

        <a asp-controller="Home" asp-action="Index"
           class="hidden lg:block text-5xl font-bold tracking-wider items-center cursor-pointer transition duration-200 hover:scale-110">
            BOOK YOUR DREAM
        </a>

        <div class="flex-shrink-0 text-xs min-[400px]:text-sm min-[500px]:text-base scale-85 min-[400px]:scale-90 min-[500px]:scale-100">
            <partial name="_LoginPartial" />
        </div>
    </header>

    <div class="mx-auto" >
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <div class="fixed bottom-0 left-1/2 transform -translate-x-1/2 bg-gradient-to-r from-emerald-600 to-teal-500 p-5 font-bold w-5/6 rounded-t-[50px] text-center shadow-lg max-h-[50px]">
        &copy; 2025 - Booking System - By Patou
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
