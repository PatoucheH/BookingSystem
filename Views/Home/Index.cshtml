@model BookingSystem.Models.ViewModels.PropertySearchViewModel
@using Microsoft.AspNetCore.Identity
@using BookingSystem.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Home";
}

@if (TempData["Error"] != null)
{
    <div class="flash-message bg-red-500 text-white p-4 rounded my-2 shadow-md animate-bounce mx-4">
        @TempData["Error"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="flash-message bg-emerald-500 text-white p-4 rounded my-2 shadow-md mx-4">
        @TempData["Success"]
    </div>
}

<div class="mx-2 sm:mx-4 lg:mx-8 mb-8 px-2 sm:px-4 lg:px-8 pb-8">
    <div class="flex flex-col lg:flex-row justify-center items-center gap-4 lg:gap-8 mx-2 sm:mx-4 mt-8">
        <div class="w-full lg:w-3/4 xl:w-4/5 bg-gradient-to-r from-teal-500 to-emerald-400
 rounded-3xl min-[800px]:rounded-full px-4 sm:px-6 lg:px-8 py-4 lg:py-6 flex items-center justify-center">
            <form asp-action="Index" method="post" class="w-full max-w-6xl">
                <div class="flex flex-wrap gap-2 min-[630px]:gap-1 min-[680px]:gap-3 lg:gap-4 min-[1400px]:gap-6 justify-center items-center mb-4">
                    <input asp-for="Town" placeholder="City"
                           class="p-2 border-b border-gray-300 rounded w-24 min-[630px]:w-22 min-[680px]:w-28 lg:w-30 min-[1400px]:w-36 text-sm lg:text-base" />
                    <input asp-for="Country" placeholder="Country"
                           class="p-2 border-b border-gray-300 rounded w-24 min-[630px]:w-22 min-[680px]:w-28 lg:w-30 min-[1400px]:w-36 text-sm lg:text-base" />
                    <input asp-for="GuestNbr" placeholder="Guest"
                           class="p-2 border-b border-gray-300 rounded w-20 min-[630px]:w-18 min-[680px]:w-22 lg:w-24 min-[1400px]:w-28 text-sm lg:text-base" />
                    <input asp-for="Price" placeholder="Price"
                           class="p-2 border-b border-gray-300 rounded w-20 min-[630px]:w-18 min-[680px]:w-22 lg:w-24 min-[1400px]:w-28 text-sm lg:text-base" />
                    <select asp-for="Type" asp-items="Html.GetEnumSelectList<BookingSystem.Models.PropertyType>()"
                            class="p-2 border rounded w-24 min-[630px]:w-22 min-[680px]:w-28 lg:w-30 min-[1400px]:w-36 text-sm lg:text-base">
                        <option value="">Type</option>
                    </select>
                </div>

                <div class="flex flex-wrap gap-2 min-[630px]:gap-1 min-[680px]:gap-3 lg:gap-4 min-[1400px]:gap-6 justify-center items-center mb-4">
                    <input asp-for="StartDate" type="date"
                           class="p-2 border rounded w-28 min-[630px]:w-26 min-[680px]:w-32 lg:w-36 min-[1400px]:w-40 text-sm lg:text-base" />
                    <input asp-for="EndDate" type="date"
                           class="p-2 border rounded w-28 min-[630px]:w-26 min-[680px]:w-32 lg:w-36 min-[1400px]:w-40 text-sm lg:text-base" />
                </div>

                <div class="flex justify-center">
                    <button type="submit" class="bg-white text-teal-700 font-bold py-2 px-4 lg:py-3 lg:px-6 rounded transition duration-200 hover:scale-110 text-sm lg:text-base">
                        Search
                    </button>
                </div>
            </form>
        </div>

        @if (SignInManager.IsSignedIn(User) && (User.IsInRole("Owner") || User.IsInRole("Admin")))
        {
            <div class="flex items-center">
                <a asp-controller="Form" asp-action="Index"
                   class="bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white font-bold py-3 px-4 lg:py-4 lg:px-8 rounded-full whitespace-nowrap hover:scale-105 transition duration-200 text-sm lg:text-base"
                   style="min-width: 120px;">
                    Add a property
                </a>
            </div>
        }
    </div>

    @if (Model.Results.Any())
    {
        <div class="grid grid-cols-1 sm:grid-cols-2 min-[1400px]:grid-cols-3 gap-4 sm:gap-6 lg:gap-8 mx-2 sm:mx-4 lg:mx-8 mb-8 mt-8">
            @foreach (var p in Model.Results)
            {
                <a asp-controller="Property" asp-action="Details" asp-route-id="@p.Id" class="block">
                    <div class="container bg-gradient-to-r from-emerald-600 to-teal-500 rounded-[30px] sm:rounded-[40px] lg:rounded-[50px] flex flex-col items-center justify-start overflow-hidden h-[400px] sm:h-[450px] lg:h-[500px] hover:scale-105 transition duration-300">
                        <div class="w-full h-[180px] sm:h-[200px] lg:h-[250px] bg-gray-600 rounded-[30px] sm:rounded-[40px] lg:rounded-[50px] flex items-center justify-center">
                            @if (!string.IsNullOrWhiteSpace(p.Photo))
                            {
                                <img src="@Url.Content(p.Photo)" alt="Property photo"
                                     class="w-full h-full object-cover rounded-[30px] sm:rounded-[40px] lg:rounded-[50px]" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center text-white text-sm sm:text-base lg:text-lg font-semibold">
                                    No Photo
                                </div>
                            }
                        </div>

                        <div class="flex-1 flex flex-col justify-between w-full p-2 lg:p-4">
                            <div>
                                <div class="text-center font-bold text-lg sm:text-xl mb-2">@p.Title</div>
                                <div class="text-center text-sm sm:text-base mb-2">@p.Town, @p.Country</div>
                                <div class="text-center text-xs sm:text-sm px-2 max-w-full overflow-hidden break-words line-clamp-2 mb-2">
                                    @p.Description
                                </div>
                            </div>

                            <div class="text-center text-sm sm:text-base">
                                <span class="font-semibold">@p.Price € / Night</span><br />
                                <span class="text-xs sm:text-sm">Max guests : @p.GuestNbr</span>
                            </div>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
    else
    {
        <div class="w-full mt-12 text-center">
            <p class="text-red-600 text-xl sm:text-2xl lg:text-3xl font-bold">No property match !</p>
        </div>
    }
</div>